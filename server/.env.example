# Server Configuration
PORT=5000
HOST=0.0.0.0

# Database Configuration
# MongoDB Atlas connection string
MONGO_URI=your_mongo_connection_string

# JWT Configuration
JWT_SECRET=your_secret_key

# Telegram Bot Configuration (for notifications)
# Get your bot token from BotFather and chat ID from a message to your bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
SEND_TELEGRAM_STARTUP_ALERT=false

# Frontend URLs (update for production)
# Used for CORS configuration
FRONTEND_URL_PRIMARY=https://rockyitservices.com
FRONTEND_URL_WWW=https://www.rockyitservices.com

# Admin OTP Authentication
# For admin panel access
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password

# Review Configuration
# REVIEW_REQUIRE_APPROVAL: Set to "true" to require admin approval before reviews are displayed
REVIEW_REQUIRE_APPROVAL=true
# REVIEW_MAX_LIMIT: Maximum number of reviews to return in a single API call
REVIEW_MAX_LIMIT=50
